<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Sources say DevMenu; the shipped dll, plugin folder and archive use the full name "Dev, Mod & Cheat Menu" (DevModCheatMenu). -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>DevModCheatMenu</AssemblyName>
    <RootNamespace>DevMenu</RootNamespace>
    <Description>Dev, Mod &amp; Cheat Menu for Obenseuer: cheats, settings of every mod, dev tools</Description>
    <Authors>absurdmane</Authors>
    <Company>absurdmane</Company>
    <Product>Dev, Mod &amp; Cheat Menu</Product>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <DebugType>embedded</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- GameDir comes from ../local.props (see local.props.example). dotnet build -p:Deploy=true copies the dll into BepInEx\plugins\DevModCheatMenu -->
    <Deploy Condition="'$(Deploy)' == ''">false</Deploy>
  </PropertyGroup>

  <ItemGroup>
    <!-- Makes private game members visible at compile time (Mono doesn't enforce access checks). -->
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(BepInExCore)\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExCore)\BepInEx.Unity.Mono.dll" Private="false" />

    <Reference Include="$(ManagedDir)\Assembly-CSharp.dll" Publicize="true" Private="false" />
    <Reference Include="$(ManagedDir)\Assembly-CSharp-firstpass.dll" Publicize="true" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Unity.Addressables.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Unity.ResourceManager.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <!-- The dll used to be DevMenu.dll in plugins\DevMenu: remove it, or both would load. -->
    <Delete Files="$(GameDir)\BepInEx\plugins\DevMenu\DevMenu.dll" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\DevModCheatMenu" />
    <Message Importance="high" Text="DevModCheatMenu -> $(GameDir)\BepInEx\plugins\DevModCheatMenu" />
  </Target>

</Project>
